# Secrets and host-specific values for compose.yaml. Copy to .env — Docker
# Compose loads it automatically from the same directory, no extra flags
# needed. Never commit the real .env (it's already in .gitignore).

# Root directory holding each game's persistent data, one subfolder per game
# (see the volumes: sections in compose.yaml.example).
USERDIR=/srv/gameservers

# Host docker group GID, so the crowsnest container's non-root user can
# reach /var/run/docker.sock. Find yours with:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# IANA timezone shared by crowsnest and every game container.
TZ=America/New_York

# How many game servers may run at the same time. 1 = only one; starting
# another is refused and the dashboard offers to switch. Raise it only if
# the host can carry several servers at once.
CROWSNEST_MAX_ACTIVE_GAMES=1

# Discord webhook posted to on idle/night auto-stop. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# --- Sign in with Google (only if config.yaml has auth.google) -----------
# From the OAuth client (Google Cloud Console -> APIs & Services -> Credentials,
# type "Web application", redirect URI https://<your host>/auth/google/callback).
CROWSNEST_GOOGLE_CLIENT_ID=
CROWSNEST_GOOGLE_CLIENT_SECRET=
# Who may sign in, and as which CrowsNest username: name=email, comma-separated.
# Any Google account not listed here is refused, even if Google signs it in.
CROWSNEST_GOOGLE_USERS=

# --- Windrose -----------------------------------------------------------
WINDROSE_SERVER_NAME=My Windrose Server
WINDROSE_SERVER_PASSWORD=
# What players type in-game to join (the game's own relay, so no port forward).
WINDROSE_INVITE_CODE=
WINDROSE_MAX_PLAYERS=4
# LAN IP of the host NIC Windrose uses for its P2P proxy (e.g. 192.168.1.10)
P2P_PROXY_ADDRESS=
# Windrose+ (live player count, world info). Set the password to match
# rcon.password in windrose_plus.json, or leave both blank to run without it.
WINDROSE_PLUS_ENABLED=false
WINDROSE_RCON_PASSWORD=

# --- Valheim --------------------------------------------------------------
VALHEIM_SERVER_NAME=My Valheim Server
VALHEIM_WORLD_NAME=Midgard
# Required, 5+ characters, and must not be contained in the server name.
VALHEIM_SERVER_PASS=
# true lists it in the in-game server browser (needs a reachable port).
VALHEIM_SERVER_PUBLIC=false
VALHEIM_BACKUPS_MAX_AGE=3

# --- Palworld -------------------------------------------------------------
PALWORLD_SERVER_NAME=CrowsNest Palworld
PALWORLD_MAX_PLAYERS=16
# Required. REST API/admin password — CrowsNest uses it for status/players,
# and the image uses it to save the world on stop. Never shared with players.
PALWORLD_ADMIN_PASSWORD=
# What players type to join. Leave blank only if you want an open server.
PALWORLD_SERVER_PASSWORD=
