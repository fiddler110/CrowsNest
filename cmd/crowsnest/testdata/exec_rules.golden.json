[
  {
    "Container": "palworld",
    "Cmd": [
      "backup"
    ]
  },
  {
    "Container": "palworld",
    "Cmd": [
      "find",
      "/palworld/backups",
      "-maxdepth",
      "1",
      "-type",
      "f",
      "-printf",
      "%T@ %s %f\\n"
    ]
  },
  {
    "Container": "valheim",
    "Cmd": [
      "/bin/sh",
      "-c",
      "mkdir -p /config/backups \u0026\u0026 tar czf /config/backups/manual-$(date +%Y%m%d-%H%M%S).tar.gz -C /config worlds_local"
    ]
  },
  {
    "Container": "valheim",
    "Cmd": [
      "find",
      "/config/backups",
      "-maxdepth",
      "1",
      "-type",
      "f",
      "-printf",
      "%T@ %s %f\\n"
    ]
  },
  {
    "Container": "windrose",
    "Cmd": [
      "/bin/sh",
      "-c",
      "mkdir -p /home/steam/server-files/backups \u0026\u0026 tar czf /home/steam/server-files/backups/world-$(date +%Y%m%d-%H%M%S).tar.gz -C /home/steam/server-files/R5/Saved SaveProfiles \u0026\u0026 chown -R 1000:1000 /home/steam/server-files/backups"
    ]
  },
  {
    "Container": "windrose",
    "Cmd": [
      "find",
      "/home/steam/server-files/backups",
      "-maxdepth",
      "1",
      "-type",
      "f",
      "-printf",
      "%T@ %s %f\\n"
    ]
  }
]
