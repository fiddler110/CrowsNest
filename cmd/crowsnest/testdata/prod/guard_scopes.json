[
  {"name": "palworld",
   "images": ["thijsvanloef/palworld-server-docker"],
   "binds": ["/srv/games/Palworld"],
   "networks": ["crowsnest-games-net"],
   "ports": [{"host_ip": "10.0.0.2", "host_port": "8211", "container_port": "8211", "proto": "udp"}],
   "labels": {"com.centurylinklabs.watchtower.enable": "false"},
   "exec": true},
  {"name": "valheim",
   "images": ["lloesche/valheim-server"],
   "binds": ["/srv/games/Valheim/config", "/srv/games/Valheim/data"],
   "networks": ["crowsnest-games-net"],
   "ports": [{"host_ip": "10.0.0.2", "host_port": "2456", "container_port": "2456", "proto": "udp"},
             {"host_ip": "10.0.0.2", "host_port": "2457", "container_port": "2457", "proto": "udp"}],
   "labels": {"com.centurylinklabs.watchtower.enable": "false"},
   "exec": true},
  {"name": "windrose",
   "images": ["indifferentbroccoli/windrose-server-docker"],
   "binds": ["/srv/games/Windrose/Config"],
   "networks": ["host"],
   "secopts": ["seccomp=unconfined", "seccomp:unconfined"],
   "ports": [],
   "labels": {"com.centurylinklabs.watchtower.enable": "false"},
   "exec": true}
]
