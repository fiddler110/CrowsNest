# Example Docker Compose stack for CrowsNest and the three game servers it
# controls. Copy to compose.yaml, copy .env.example to .env and fill in your
# secrets/paths, then start only the controller by default:
#
#   docker compose up -d crowsnest
#
# CrowsNest itself starts/stops the game services on demand via the Docker
# socket; you generally don't run `--profile <game> up` yourself. See
# config.yaml.example for the matching CrowsNest configuration.
#
# How CrowsNest runs compose: it calls `docker compose -f /data/compose.yaml
# --profile <game> up -d <game>` from *inside* its own container. Three
# things make that behave the same as running compose on the host:
#   - the top-level `name:` below pins the project name (otherwise it would
#     be "data", after the mount directory, and the game would land on a
#     different network than crowsnest);
#   - .env is mounted next to the compose file, so compose interpolates the
#     same ${USERDIR}/passwords it would on the host (without it they are
#     blank: saves land in /<Game> on the host root and the game password
#     is empty);
#   - host paths in game services must be absolute (${USERDIR}/...): a
#     relative ./path would resolve against /data inside the container.
# Compose interpolates the *whole* file even when starting one service, so
# avoid ${VAR:?error} in game services — one unset variable for game A
# would block starting game B.
#
# Docker socket access — two ways to grant it:
#
#   1. Direct socket mount (default below): simplest, but a container with
#      /var/run/docker.sock has root-equivalent control of the whole host —
#      anything that ever runs code inside the crowsnest container inherits
#      that. Fine for a small trusted homelab; worth knowing the blast
#      radius before exposing this beyond your LAN.
#   2. docker-socket-proxy (commented out below): puts a small HTTP proxy
#      (github.com/Tecnativa/docker-socket-proxy) between crowsnest and the
#      real socket, allowlisting only the Docker API endpoints crowsnest
#      actually calls (list/inspect/start/stop/exec/logs/stats/compose) and
#      rejecting everything else (image builds, volume/network deletion,
#      swarm, secrets, ...). To switch to it: comment out crowsnest's
#      `group_add` and the `/var/run/docker.sock` volume line below,
#      uncomment the `dockerproxy` service and crowsnest's `depends_on`
#      line, and set `server.docker_host: tcp://dockerproxy:2375` in
#      config.yaml (see config.yaml.example) — crowsnest passes that
#      straight through as the docker CLI's `-H` flag on every call, no
#      env var needed. Verified against a real Tecnativa proxy: read-only
#      calls (ps/inspect/stats) work unchanged, and the proxy correctly
#      403s any call outside the allowlisted set below.
#
#      Exec access (Windrose's status check and per-game backups use
#      `docker exec`): the proxy can only switch exec on or off, not say
#      which commands may run, so EXEC=1 alone is code execution in every
#      container it can see. Put the `execguard` service below in front of
#      it instead: crowsnest talks only to execguard, which allows exactly
#      the commands config.yaml implies (each game's backup `exec`, its
#      `list_dir` listing, Windrose's readiness grep) and 403s any other
#      exec. The two-network layout keeps crowsnest from reaching the proxy
#      directly. Drop EXEC=1 and execguard if you use neither feature.

name: crowsnest

services:
  crowsnest:
    image: ghcr.io/fiddler110/crowsnest:latest
    # Building from source instead (e.g. local changes):
    # build: .
    container_name: crowsnest
    restart: unless-stopped
    ports:
      - "5000:5000"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - TZ=${TZ:-UTC}
      - CROWSNEST_MAX_ACTIVE_GAMES=${CROWSNEST_MAX_ACTIVE_GAMES:-1}
      - DISCORD_WEBHOOK_URL=${DISCORD_WEBHOOK_URL:-}
      - WINDROSE_RCON_PASSWORD=${WINDROSE_RCON_PASSWORD:-}
      - PALWORLD_ADMIN_PASSWORD=${PALWORLD_ADMIN_PASSWORD:-}
      - CROWSNEST_GOOGLE_CLIENT_ID=${CROWSNEST_GOOGLE_CLIENT_ID:-}
      - CROWSNEST_GOOGLE_CLIENT_SECRET=${CROWSNEST_GOOGLE_CLIENT_SECRET:-}
      - CROWSNEST_GOOGLE_USERS=${CROWSNEST_GOOGLE_USERS:-}
      - DOCKER_CONFIG=/tmp/.docker   # the docker CLI's config dir; the root filesystem is read-only
    # Hardening: CrowsNest runs as a non-root user, needs no Linux
    # capabilities (port 5000, no raw sockets), and only writes users.env and
    # the session secret (both bind mounts) plus /tmp.
    read_only: true
    tmpfs:
      - /tmp:size=16m,mode=1777
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    pids_limit: 256   # docker/compose subprocesses + log streams (capped at 20 in the app)
    mem_limit: 512m
    # Grants the container's non-root user access to the host Docker socket.
    # Run `stat -c '%g' /var/run/docker.sock` to find your host's docker
    # group GID if it differs from the Debian/Ubuntu default of 999.
    # Not needed when using the dockerproxy alternative below — remove this
    # and the docker.sock volume line, and set server.docker_host instead.
    group_add:
      - "${DOCKER_GID:-999}"
    volumes:
      - ./config.yaml:/app/config.yaml:ro
      - ./users.env:/app/users.env
      - ./session_secret:/app/.session_secret
      # Settings saved from the dashboard. A directory, not a file, and writable by uid 1000
      # (`mkdir -p ${USERDIR}/crowsnest/config && chown 1000 ${USERDIR}/crowsnest/config`).
      - ${USERDIR}/crowsnest/config:/app/data
      # Shared backups folder (optional; see README, Backups): the host folder, read-write, one sub-folder per game.
      # - ${BACKUPS_DIR}:/game-backups
      - ./compose.yaml:/data/compose.yaml:ro
      - ./.env:/data/.env:ro   # compose in the container interpolates from this
      - /var/run/docker.sock:/var/run/docker.sock
    # depends_on:
    #   - dockerproxy

  # docker-socket-proxy alternative to mounting /var/run/docker.sock
  # straight into crowsnest — see the note above. Uncomment this service,
  # comment out crowsnest's group_add/docker.sock lines above, and set
  # `server.docker_host: tcp://dockerproxy:2375` in config.yaml.
  # dockerproxy:
  #   image: ghcr.io/tecnativa/docker-socket-proxy:latest
  #   container_name: crowsnest-dockerproxy
  #   restart: unless-stopped
  #   # No ports: — only reachable from other containers on this compose
  #   # network, never from the host or the internet.
  #   volumes:
  #     - /var/run/docker.sock:/var/run/docker.sock:ro
  #   environment:
  #     # Read-only inspection — status/logs/stats/`docker ps`:
  #     - CONTAINERS=1
  #     - IMAGES=1
  #     - NETWORKS=1
  #     - VOLUMES=1
  #     - INFO=1
  #     - VERSION=1
  #     - PING=1
  #     - GET=1
  #     - HEAD=1
  #     # Needed for start/stop/switch and `docker compose up`:
  #     - POST=1
  #     - START=1
  #     - STOP=1
  #     - CREATE=1
  #     # Needed only for Windrose's status check and backups. Reachable only
  #     # through execguard below, which restricts which commands run.
  #     - EXEC=1
  #     # Leave everything else at the proxy's secure-by-default 0: no
  #     # BUILD, DELETE, SECRETS, SERVICES, SWARM, SYSTEM, etc.

  # Exec allowlist in front of dockerproxy (see the note at the top). Same image as
  # crowsnest; reads the same config.yaml to learn which commands are allowed, and
  # must be restarted when backup settings change. Give it a `networks:` block with
  # `crowsnest_front` (shared with crowsnest) and `crowsnest_back` (shared with
  # dockerproxy), put crowsnest on `crowsnest_front` only, dockerproxy on
  # `crowsnest_back` only, and set `server.docker_host: tcp://execguard:2375`.
  # (To avoid a second container, run the guard below with `--exec` instead: it serves this allowlist in
  # front of itself, in one process. It then needs config.yaml mounted, as execguard does. See quickstart/compose.yaml.)
  # execguard:
  #   image: ghcr.io/fiddler110/crowsnest:latest
  #   container_name: crowsnest-execguard
  #   restart: unless-stopped
  #   command: ["execguard", "--listen", ":2375", "--upstream", "tcp://dockerproxy:2375"]
  #   read_only: true
  #   cap_drop: [ALL]
  #   security_opt: ["no-new-privileges:true"]
  #   volumes:
  #     - ./config.yaml:/app/config.yaml:ro
  #   networks: [crowsnest_front, crowsnest_back]
  # networks (top level):
  #   crowsnest_front: {}
  #   crowsnest_back: {internal: true}

  # Alternative to dockerproxy: `crowsnest guard`, a scoped Docker API filter built into the same image. It
  # sees and controls only the containers listed in GUARD_SCOPES (one scope per container: image repository,
  # exact bind paths, networks, published ports, labels, aliases, and whether exec is on), pulls only those
  # images, creates only matching containers (compose's recreate included), filters lists and inspects and
  # redacts /info. Refusals are logged: `docker logs dockerproxy-crowsnest 2>&1 | grep DENY`. It refuses to
  # start without a valid GUARD_SCOPES. Use it in place of `dockerproxy` above (execguard's --upstream
  # then points at it); exec is still switched on per scope here and restricted by execguard.
  # A fixed container address is refused unless the scope pins it: "ipv4": {"<network>": ["10.0.1.16"]} lists the
  # exact addresses that container may take on that network (the network must be in "networks"). Use it when
  # something outside Docker keys on the address, such as a firewall rule for a macvlan container.
  # guard:
  #   image: ghcr.io/fiddler110/crowsnest:latest
  #   container_name: dockerproxy-crowsnest
  #   command: ["guard", "--listen", ":2375"]
  #   restart: unless-stopped
  #   user: "1000"
  #   group_add: ["${DOCKER_GID:-988}"]
  #   read_only: true
  #   cap_drop: [ALL]
  #   security_opt: ["no-new-privileges:true"]
  #   environment:
  #     - >-
  #       GUARD_SCOPES=[{"name": "palworld", "images": ["thijsvanloef/palworld-server-docker"],
  #         "binds": ["${USERDIR}/Palworld"], "networks": ["crowsnest-games-net"],
  #         "ports": [{"host_ip": "10.0.0.2", "host_port": "8211", "container_port": "8211", "proto": "udp"}],
  #         "labels": {"com.centurylinklabs.watchtower.enable": "false"}, "exec": true}]
  #   healthcheck:
  #     test: ["CMD", "wget", "-qO-", "http://127.0.0.1:2375/_ping"]
  #   volumes:
  #     - /var/run/docker.sock:/var/run/docker.sock

  # Windrose: host networking and an invite code (the game's own P2P relay), so players need no port forward.
  # Everything lives in one directory, ${USERDIR}/Windrose, which is the server's install folder: the world
  # is R5/Saved/SaveProfiles/Default/ inside it, and Windrose+ keeps windrose_plus.json beside it. Point
  # this at an existing server folder to keep its save.
  windrose:
    image: indifferentbroccoli/windrose-server-docker:latest
    profiles: ["windrose"]
    container_name: windrose
    restart: unless-stopped
    stop_grace_period: 30s
    network_mode: host
    security_opt:
      - seccomp:unconfined   # required by the image's Wine runtime
    environment:
      - TZ=${TZ:-UTC}
      - PUID=${PUID:-1000}
      - PGID=${PGID:-1000}
      - SERVER_NAME=${WINDROSE_SERVER_NAME:-My Windrose Server}
      - SERVER_PASSWORD=${WINDROSE_SERVER_PASSWORD:-}
      - INVITE_CODE=${WINDROSE_INVITE_CODE:-}           # what players type to join
      - MAX_PLAYERS=${WINDROSE_MAX_PLAYERS:-4}
      - P2P_PROXY_ADDRESS=${P2P_PROXY_ADDRESS:-}        # host LAN IP, set in .env
      - UPDATE_ON_START=true
      - WINDROSE_PLUS_ENABLED=${WINDROSE_PLUS_ENABLED:-false}
      - WINDROSE_PLUS_RCON_PASSWORD=${WINDROSE_RCON_PASSWORD:-}
    volumes:
      - ${USERDIR}/Windrose:/home/steam/server-files

  # Valheim: /config holds the world (worlds_local/<WORLD_NAME>.db and .fwl), adminlist.txt and backups, so
  # that is the folder to drop an existing world into. /opt/valheim is the server install, kept so restarts
  # don't re-download it.
  valheim:
    image: lloesche/valheim-server:latest
    profiles: ["valheim"]
    container_name: valheim
    restart: unless-stopped
    stop_grace_period: 2m
    ports:
      - "2456-2457:2456-2457/udp"
    environment:
      - TZ=${TZ:-UTC}
      - SERVER_NAME=${VALHEIM_SERVER_NAME:-My Valheim Server}
      - WORLD_NAME=${VALHEIM_WORLD_NAME:-Midgard}
      - SERVER_PASS=${VALHEIM_SERVER_PASS:-}   # required by the image (5+ chars)
      - SERVER_PUBLIC=${VALHEIM_SERVER_PUBLIC:-false}   # list in the in-game server browser
      - BACKUPS_MAX_AGE=${VALHEIM_BACKUPS_MAX_AGE:-3}   # days of automatic world backups to keep
    volumes:
      - ${USERDIR}/Valheim/config:/config
      - ${USERDIR}/Valheim/data:/opt/valheim

  palworld:
    image: thijsvanloef/palworld-server-docker:latest
    profiles: ["palworld"]
    container_name: palworld
    restart: unless-stopped
    # The image saves via its REST API on SIGTERM, then waits up to 30s for
    # the server to exit — give it room.
    stop_grace_period: 60s
    # Palworld's README asks for 16GB+; cap it so a leak can't take the
    # host down with it (tune to your host).
    # mem_limit: 10g
    ports:
      - "8211:8211/udp"
      # No 8212 mapping: the REST API (admin password = full server control)
      # must not be exposed. crowsnest reaches it as http://palworld:8212
      # over this project's network.
    environment:
      - TZ=${TZ:-UTC}
      - PUID=1000
      - PGID=1000
      - PORT=8211
      - PLAYERS=${PALWORLD_MAX_PLAYERS:-16}
      - MULTITHREADING=true
      - REST_API_ENABLED=true
      - REST_API_PORT=8212
      - RCON_ENABLED=true   # only for crowsnest's optional raw console (rcon_addr); not published
      - RCON_PORT=25575
      - ADMIN_PASSWORD=${PALWORLD_ADMIN_PASSWORD:-}   # required: REST API password, also used to save on stop
      - SERVER_PASSWORD=${PALWORLD_SERVER_PASSWORD:-}
      - SERVER_NAME=${PALWORLD_SERVER_NAME:-CrowsNest Palworld}
      - COMMUNITY=false            # not listed in the community server browser
      - BACKUP_ENABLED=true        # daily, to /palworld/backups
      - DELETE_OLD_BACKUPS=true
      - OLD_BACKUP_DAYS=14
    volumes:
      - ${USERDIR}/Palworld:/palworld
