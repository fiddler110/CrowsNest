# CrowsNest configuration.
#
# Copy this file to config.yaml and edit it, then bind-mount it into the
# container at /app/config.yaml (or point CROWSNEST_CONFIG elsewhere).
# See compose.yaml.example for the matching Docker Compose setup and
# docs/implementation-plan.md for the full schema/behavior reference.

server:
  addr: ":5000"
  session_secret_file: /app/.session_secret   # generated on first run if absent
  tz: "America/New_York"                      # IANA name; used by night_shutdown and logs
  # metrics_token_env: CROWSNEST_METRICS_TOKEN   # names an env var; when it is set, GET /metrics serves
  #                                               # Prometheus metrics to `Authorization: Bearer <token>`
  # trusted_proxies: ["10.0.0.0/8"]           # CIDRs allowed to set X-Forwarded-For
  # docker_host: tcp://dockerproxy:2375       # route docker/compose calls through a
                                               # docker-socket-proxy instead of the raw
                                               # socket mount — see compose.yaml.example
  # secure_cookies: true                      # set once a TLS-terminating reverse proxy
                                               # sits in front of CrowsNest; marks the
                                               # session cookie Secure and adds HSTS

  # max_active_games: 1                       # how many game servers may run at once. 1 (the
                                               # default) = starting a second one is refused
                                               # and the UI offers to switch. Raise it on a
                                               # bigger host; CROWSNEST_MAX_ACTIVE_GAMES in
                                               # .env overrides this.

  # host_disk_paths: [/app/data, /data]      # free space shown on the dashboard; mount the disk
                                               # your game data lives on and list it here
  # history_file: /app/data/events.jsonl      # activity log (who did what, joins/leaves, playtime)
  # history_retention_days: 180               # older entries are pruned
  # settings_file: /app/data/settings.json   # where changes made from the dashboard's Settings
                                               # dialog are saved (mount the directory, writable
                                               # by uid 1000). They override the values in this
                                               # file; delete it to reset.
  # auto_update: false                        # pull the latest image every time a game starts

idle_shutdown:
  enabled: true
  idle_minutes: 15
  check_interval_seconds: 60

night_shutdown:                # off by default — a preset curfew is a stronger,
  enabled: false                # more surprising behavior than idle_shutdown alone
  start_hour: 23                # 0-23, local to server.tz; wraps midnight if > end_hour
  end_hour: 5
  check_interval_minutes: 30
  min_uptime_minutes: 30        # a game started inside the window is left alone until it
                                # has been up this long, so a late session can get going

notifications:                 # Discord webhook, posted on both idle and night auto-stop
  discord_webhook_url_env: DISCORD_WEBHOOK_URL   # names an env var; unset/empty = disabled
  # player_events: false          # join/leave messages are on whenever a webhook is set

# A game that crashes (non-zero exit, not a normal stop) this many times inside the window is
# reported once: an entry in the activity log and, with a webhook above, a Discord message.
# crash_loop:
#   enabled: true
#   crashes: 3
#   window_minutes: 15

users_file: /app/users.env     # <NAME>_PASSWORD_HASH entries; managed by `crowsnest set-password`

# How people sign in. With no auth section, only username/password (users_file) is used.
# auth:
#   password_login: false         # default true; false makes Google the only way in
#   google:                       # "Sign in with Google"; see README "Signing in with Google"
#     # Must also be an authorized redirect URI on the Google OAuth client.
#     # An https URL requires server.secure_cookies: true.
#     redirect_url: https://crowsnest.example.com/auth/google/callback
#     # These name env vars (set in .env); the defaults are shown.
#     # client_id_env: CROWSNEST_GOOGLE_CLIENT_ID
#     # client_secret_env: CROWSNEST_GOOGLE_CLIENT_SECRET
#     # users_env: CROWSNEST_GOOGLE_USERS    # the allowlist: name=email,name=email

games:
  - id: windrose
    display_name: Windrose
    container_name: windrose
    compose_file: /data/compose.yaml
    compose_profile: windrose
    compose_service: windrose
    # Windrose+ integration (optional): live player count/names, world time
    # and weather, connection info, memory usage, multipliers. Omit this
    # block to run with docker-ps-only status and no player count.
    windrose:
      http_api_url: http://host.docker.internal:8780
      rcon_password_env: WINDROSE_RCON_PASSWORD

  - id: valheim
    display_name: Valheim
    container_name: valheim
    compose_file: /data/compose.yaml
    compose_profile: valheim
    compose_service: valheim
    # night_shutdown: false     # opt this game out, e.g. a friend group spanning time zones

  - id: palworld
    display_name: Palworld
    container_name: palworld
    compose_file: /data/compose.yaml
    compose_profile: palworld
    compose_service: palworld
    # Optional connection details shown on the game's card, with a copy
    # button for each value. All of it is shown to every logged-in user.
    # See docs/connecting.md for reaching the game without a router port
    # forward (e.g. a LAN address routed over Tailscale).
    # connect_address: play.example.com:8211
    # connect_note: Turn on Tailscale first
    # connect_secrets: values read from env vars (so they stay in .env, not
    # here) and shown under the address. List only what every signed-in
    # player may see, such as the join password. NEVER the admin/REST
    # password. The env var must also be passed to the crowsnest container
    # in compose.yaml. An unset or empty variable is left out.
    # connect_secrets:
    #   - {label: Join password, env: PALWORLD_SERVER_PASSWORD}
    # Palworld's dedicated server REST API (enable REST_API_ENABLED on the
    # server container) doubles as status probe and player counter.
    palworld:
      rest_api_url: http://palworld:8212
      rest_api_user: admin
      rest_api_password_env: PALWORLD_ADMIN_PASSWORD
      # Optional: lets an admin enable the raw RCON console in Settings.
      # Needs RCON_ENABLED=true on the game; the password defaults to the
      # REST API one (palworld-server-docker uses ADMIN_PASSWORD for both).
      # rcon_addr: palworld:25575
      # rcon_password_env: PALWORLD_ADMIN_PASSWORD
    # Admin-only "Backups" panel. Runs inside the container with `docker exec`
    # (the socket proxy needs EXEC=1, behind
    # `crowsnest execguard`, which only allows the commands set here; with `crowsnest guard` the scope needs "exec": true). palworld-server-docker ships a `backup`
    # command and writes to /palworld/backups; check both against your image.
    # backup:
    #   exec: ["backup"]
    #   list_dir: /palworld/backups
    #   keep: 14                      # optional: after each backup, delete all but the newest 14 files in list_dir
    #   before_stop: true      # also back up every time CrowsNest stops it on purpose

# Enable and configure games from the dashboard, inside an operator policy
# (see docs/modules.md and policy.yaml.example). Needs platform.games_root.
# platform:
#   games_root: /srv/games
#   host_ip: 10.0.0.2
# managed:
#   dir: /app/data/managed
#   policy_file: /etc/crowsnest/policy.yaml
