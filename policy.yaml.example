# Operator-owned envelope for what the dashboard may add. Mount read-only into
# the guard (GUARD_POLICY=/etc/crowsnest/policy/policy.yaml) next to GUARD_SCOPES_FILE.
# Mount the DIRECTORY holding this file, not the file: an editor that replaces it leaves a file mount stale.
# See docs/modules.md. Every list is required: no limit is ever implied.
games_root: /srv/games
# backups_root: /mnt/usb/crowsnest-backups   # optional second bindable folder, for each game's own <root>/<id> backups;
#                                            # separate from games_root, and the same path as platform.backups_root
names: [valheim, palworld, minecraft, "gs-*"]
images: [lloesche/valheim-server, thijsvanloef/palworld-server-docker, "docker.io/itzg/*"]
networks: [crowsnest-games-net]
ports: ["25000-28999/udp", "25565/tcp"]
host_ips: [10.0.0.2]
exec: false
# Dashboard games run their image by digest (repo@sha256:...), resolved when they are
# enabled or updated, so an upstream push changes nothing until you press Update image.
# true: the guard refuses a dashboard-game create that names a tag. Pulls by tag stay
# allowed; your own GUARD_SCOPES are not affected.
pin_digests: true
max_scopes: 64
