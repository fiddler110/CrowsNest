# Copy to .env (docker compose reads it from this folder).
TZ=UTC
# Group id of /var/run/docker.sock on the host:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# 127.0.0.1 keeps the panel on this machine. Use 0.0.0.0 only behind HTTPS or on a trusted LAN.
CROWSNEST_BIND=127.0.0.1
# Pin a release once you are happy:  CROWSNEST_TAG=0.12.0
CROWSNEST_TAG=latest
