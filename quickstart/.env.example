# Copy to .env (docker compose reads it from this folder).
TZ=UTC
# Group id of /var/run/docker.sock on the host:  stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# 127.0.0.1 keeps the panel on this machine. Use 0.0.0.0 only behind HTTPS or on a trusted LAN.
CROWSNEST_BIND=127.0.0.1
# The release to run (compose refuses to start without it). To upgrade, change it and see "Upgrading" in README.md.
# The release page's quickstart.tar.gz has this set to its own version. "latest" follows every release unpinned.
CROWSNEST_TAG=0.9.0
# Optional shared backups folder, an absolute host path (an external drive is fine). Needs the volume in compose.yaml,
# platform.backups_root in config.yaml and backups_root in policy/policy.yaml, all the same path.
# BACKUPS_DIR=/mnt/usb/crowsnest-backups
